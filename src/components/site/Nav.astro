---
import { SITE } from '../../data/site';
import ThemeSwitcher from './ThemeSwitcher.astro';
import Button from './Button.astro';
import '../../styles/site.css';

let stars = 0;
try {
  const res = await fetch(`https://api.github.com/repos/${SITE.repo}`, {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = (await res.json()) as { stargazers_count: number };
    stars = data.stargazers_count;
  }
} catch {
  stars = 0;
}

const starLabel = stars > 0 ? stars.toLocaleString('en-US') : '—';
---

<div data-nav-sentinel aria-hidden="true" style="position:fixed; top:0; height:1px; width:100%; pointer-events:none;"></div>

<header data-nav class="mn-nav">
  <div class="mn-nav-inner">
    <a href="/" class="mn-nav-brand" aria-label="Minnow — home">
      <span class="mn-nav-mark" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <path d="M 16 50 C 26 36, 44 32, 56 42 L 69 50 L 56 58 C 44 68, 26 64, 16 50 Z" />
          <path d="M 69 50 L 84 40 L 81 50 L 84 60 Z" />
          <circle cx="27" cy="46" r="2.2" style="fill: var(--mn-bg)" />
        </svg>
      </span>
      <span class="mn-nav-word">Minnow</span>
    </a>

    <nav aria-label="Primary">
      <ul class="mn-nav-links">
        <li><a href="/docs">Docs</a></li>
        <li><a href="/changelog">Changelog</a></li>
        <li><a href="/#themes">Themes</a></li>
      </ul>
    </nav>

    <div class="mn-nav-actions">
      <a class="mn-star-chip" href={SITE.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Star Minnow on GitHub — ${starLabel} stars`}>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      <span>{starLabel}</span>
      </a>

      <button type="button" class="mn-search-trigger" data-search-trigger aria-label="Search the docs (press Control or Command plus K)">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M10.68 11.74a6 6 0 1 1 1.06-1.06l3.04 3.04a.75.75 0 1 1-1.06 1.06l-3.04-3.04Zm-4.68-3.56a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        </svg>
        <span class="mn-search-trigger-keys" aria-hidden="true">
          <kbd class="mn-search-trigger-kbd">⌘</kbd>
          <kbd class="mn-search-trigger-kbd">K</kbd>
        </span>
      </button>

      <ThemeSwitcher />

      <a class="mn-icon-btn" href={SITE.discord} target="_blank" rel="noopener noreferrer" aria-label="Join the Discord">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03ZM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z" />
        </svg>
      </a>

      <Button href="/download" variant="primary" size="sm">Download</Button>
    </div>

    <button class="mn-nav-burger" data-sheet-toggle aria-expanded="false" aria-controls="mn-mobile-sheet" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div data-sheet-scrim class="mn-sheet-scrim" aria-hidden="true"></div>
<div data-sheet id="mn-mobile-sheet" class="mn-sheet" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <button class="mn-sheet-close" data-sheet-close aria-label="Close menu">
    <svg viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M3 3l12 12M15 3L3 15" />
    </svg>
  </button>
  <ul class="mn-sheet-links">
    <li><a href="/docs">Docs</a></li>
    <li><a href="/changelog">Changelog</a></li>
    <li><a href="/#themes">Themes</a></li>
  </ul>
  <div class="mn-sheet-actions">
    <Button href="/download" variant="primary">Download</Button>
    <a class="mn-icon-btn" href={SITE.discord} target="_blank" rel="noopener noreferrer" aria-label="Join the Discord">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03ZM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z" />
      </svg>
    </a>
    <a class="mn-star-chip" href={SITE.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Star Minnow on GitHub — ${starLabel} stars`}>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span>{starLabel}</span>
    </a>
  </div>
</div>

<script>
  import { initNav } from '../../scripts/nav';
  import { initSheet } from '../../scripts/sheet';
  import { initThemeSwitcher } from '../../scripts/theme-switch';
  import { openSearch } from '../../scripts/search';

  initNav();
  initSheet();
  document.querySelector<HTMLElement>('[data-search-trigger]')?.addEventListener('click', () => openSearch());
  const root = document.querySelector<HTMLElement>('[data-theme-switcher]');
  if (root) initThemeSwitcher(root);
</script>