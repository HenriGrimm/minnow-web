---
import '../../styles/site.css';

interface Props {
  boxed?: boolean;
  class?: string;
  [key: string]: any;
}

const { boxed = false, class: className = '', ...rest } = Astro.props as Props;
---

<span class={`mn-eyebrow ${boxed ? 'mn-eyebrow-boxed' : ''} ${className}`} {...rest}>
  {Astro.slots.default ? await Astro.slots.render('default') : null}
</span>