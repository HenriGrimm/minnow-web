---
import '../../styles/site.css';

interface Props {
  boxed?: boolean;
  class?: string;
  children?: any;
  [key: string]: any;
}

const { boxed = false, class: className = '', children, ...rest } = Astro.props as Props;
---

<span class={`mn-eyebrow ${boxed ? 'mn-eyebrow-boxed' : ''} ${className}`} {...rest}>
  {children}
</span>