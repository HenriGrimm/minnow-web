---
/**
 * StatusBar — the 30px strip under the composer: "Terminal" on the
 * left, the token rate on the right. Mono, tabular-nums.
 */
---
<footer class="app-statusbar">
  <span class="app-statusbar-left">
    <span>Terminal</span>
    <span class="app-statusbar-sep" aria-hidden="true">·</span>
    <span>node v24.18.0</span>
  </span>
  <span class="app-statusbar-right">
    <span>58.5 t/s</span>
    <span class="app-statusbar-sep" aria-hidden="true">·</span>
    <span>3.1k tok</span>
    <span class="app-statusbar-sep" aria-hidden="true">·</span>
    <span>ctx 12.4%</span>
  </span>
</footer>
