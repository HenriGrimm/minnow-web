---
const { size = 24, label } = Astro.props;
const aria = label ? { 'aria-label': label, role: 'img' } : { 'aria-hidden': 'true' };
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...aria}
>
  <path d="M6 6l12 12" />
  <path d="M18 6L6 18" />
</svg>