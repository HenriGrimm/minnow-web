---
const { size = 24, label } = Astro.props;
const aria = label ? { 'aria-label': label, role: 'img' } : { 'aria-hidden': 'true' };
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...aria}
>
  <path d="M16.5 3.5h-9A3.5 3.5 0 0 0 4 7v11.5A3.5 3.5 0 0 0 7.5 22h9a3.5 3.5 0 0 0 3.5-3.5V7a3.5 3.5 0 0 0-3.5-3.5Z" />
  <path d="M8 3v3" />
  <path d="M12 3v3" />
  <path d="M16 3v3" />
  <rect x="7.5" y="10" width="5" height="5" rx="1" />
</svg>