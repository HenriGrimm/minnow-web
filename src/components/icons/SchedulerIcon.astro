---
const { size = 24, label } = Astro.props;
const aria = label ? { 'aria-label': label, role: 'img' } : { 'aria-hidden': 'true' };
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...aria}
>
  <circle cx="12" cy="13" r="8" />
  <path d="M12 9.5V13l2.5 2.5" />
  <path d="M9 2h6" />
  <path d="M12 2v1.5" />
</svg>