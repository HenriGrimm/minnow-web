---
/**
 * Status — spec §6.2 §12. "One maintainer." The honest one-maintainer
 * paragraph, stated plainly, and the three places where that actually
 * helps — Discord, Issues, Sponsor. No roadmap theater, no "enterprise
 * support" column, no SLA.
 */
import Eyebrow from '../site/Eyebrow.astro';
import { SITE } from '../../data/site';

const links = [
  {
    label: 'Discord',
    href: SITE.discord,
    line: 'The maintainer is here in the community channel. So are the answers to half the questions you were about to ask.',
  },
  {
    label: 'Issues',
    href: SITE.issuesUrl,
    line: 'A bug is a bug even if the maintainer has not seen it. File it — with the version and the steps, and it is in the queue.',
  },
  {
    label: 'Sponsor',
    href: SITE.sponsor,
    line: 'Sponsorship keeps one-maintainer sustainable. It is the difference between a hobby and a release cadence.',
  },
];
---

<section id="status" class="mn-section mn-section-hairline" aria-labelledby="status-heading">
  <div class="mn-section-inner mn-status-inner">
    <Eyebrow boxed>STATUS</Eyebrow>
    <h2 id="status-heading" class="mn-status-h2">
      One maintainer. Here is what that means.
    </h2>
    <p class="mn-status-lead">
      Minnow is maintained by one person — {SITE.author} — with the
      source open under AGPL-3.0-or-later and a community that keeps the
      issues honest. That means the release cadence is human, the triage
      is careful, and the roadmap is a list of things the maintainer is
      actually working on, not a list of things a sales team promised.
    </p>
    <p class="mn-status-lead mn-status-lead-2">
      It also means a bug report from a stranger is the highest-value
      input the project gets. If something is wrong, tell the project.
      The maintainer reads the queue, and the community reads it too.
    </p>

    <div class="mn-status-links">
      {
        links.map((link) => (
          <a
            class="mn-status-link"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="mn-status-link-label">{link.label}</span>
            <span class="mn-status-link-line">{link.line}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* stylelint-disable custom-property-empty-line-before, declaration-empty-line-before */

  .mn-status-inner {
    max-width: 900px;
  }

  .mn-status-h2 {
    margin: 0 0 24px;
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--lh-title);
  }

  .mn-status-lead {
    margin: 0 0 20px;
    max-width: var(--prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--mn-fg-muted);
  }

  .mn-status-lead-2 {
    margin-bottom: 40px;
  }

  /* ---------- Discord / Issues / Sponsor ---------- */

  .mn-status-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (width <= 700px) {
    .mn-status-links {
      grid-template-columns: 1fr;
    }
  }

  .mn-status-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--mn-surface-0);
    border: 1px solid var(--mn-border);
    border-radius: var(--radius-lg);
  }

  .mn-status-link-label {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--mn-accent-ink);
  }

  .mn-status-link-line {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--mn-fg-muted);
  }
</style>