---
/**
 * FreeForever — spec §6.2 §11. "Free, forever." The no-tier line up
 * front, the Blender paragraph in full (the precedent the license
 * follows), and the three ways to keep it moving — Sponsor, Discord,
 * GitHub. No pricing table, no tiers, no "contact us" — there is
 * nothing to buy, so there is nothing to price.
 */
import Eyebrow from '../site/Eyebrow.astro';
import { SITE } from '../../data/site';

const links = [
  {
    label: 'Sponsor',
    href: SITE.sponsor,
    line: 'A sponsor keeps the maintainer fed and the releases moving.',
  },
  {
    label: 'Discord',
    href: SITE.discord,
    line: 'The community channel — questions, feedback, and the odd good idea.',
  },
  {
    label: 'GitHub',
    href: SITE.repoUrl,
    line: `The source of ${SITE.repo} — read it, fork it, file an issue.`,
  },
];
---

<section id="free-forever" class="mn-section mn-section-hairline" aria-labelledby="free-forever-heading">
  <div class="mn-section-inner mn-free-forever-inner">
    <Eyebrow boxed>FREE, FOREVER</Eyebrow>
    <h2 id="free-forever-heading" class="mn-free-forever-h2">
      No feature is ever withheld to make a paid tier.
    </h2>
    <p class="mn-free-forever-lead">
      There is no tier. There is no "pro" mode, no feature flag held
      hostage to a subscription, no part of the app that unlocks when you
      pay. What ships is what you get, and it is under the same license
      you can read in the repo.
    </p>

    <div class="mn-free-forever-blender">
      <h3 class="mn-free-forever-blender-title">The precedent</h3>
      <p>
        Blender did this with 3D. A full production-grade renderer,
        modeler, and compositor — free under the GPL, with the source
        open, and every feature available to every user from day one. The
        studio you could not afford before the license change is the
        studio that ships short films now. The software was not a
        free-to-try version of a paid product; it was the product,
        uncut.
      </p>
      <p>
        Minnow follows the same rule. The plan that makes a paid tier
        worthwhile is the plan that has no paid tier to make.
      </p>
    </div>

    <div class="mn-free-forever-links">
      {
        links.map((link) => (
          <a
            class="mn-free-forever-link"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="mn-free-forever-link-label">{link.label}</span>
            <span class="mn-free-forever-link-line">{link.line}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* stylelint-disable custom-property-empty-line-before, declaration-empty-line-before */

  .mn-free-forever-inner {
    max-width: 900px;
  }

  .mn-free-forever-h2 {
    margin: 0 0 24px;
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--lh-title);
  }

  .mn-free-forever-lead {
    margin: 0 0 40px;
    max-width: var(--prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--mn-fg-muted);
  }

  /* ---------- The Blender paragraph ---------- */

  .mn-free-forever-blender {
    padding: 24px 28px;
    margin-bottom: 40px;
    background: color-mix(in srgb, var(--mn-fg) 1.5%, var(--mn-bg));
    border: 1px solid var(--mn-border);
    border-radius: var(--radius-lg);
  }

  .mn-free-forever-blender-title {
    margin: 0 0 12px;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--mn-fg-subtle);
  }

  .mn-free-forever-blender p {
    margin: 0 0 14px;
    max-width: var(--prose);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mn-fg-muted);
  }

  .mn-free-forever-blender p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Sponsor / Discord / GitHub ---------- */

  .mn-free-forever-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (width <= 700px) {
    .mn-free-forever-links {
      grid-template-columns: 1fr;
    }
  }

  .mn-free-forever-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--mn-surface-0);
    border: 1px solid var(--mn-border);
    border-radius: var(--radius-lg);
  }

  .mn-free-forever-link-label {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--mn-accent-ink);
  }

  .mn-free-forever-link-line {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--mn-fg-muted);
  }
</style>