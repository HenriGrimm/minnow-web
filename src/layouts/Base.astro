---
import '../styles/vendor/tokens.css';
import '../styles/tokens.site.css';
import '../styles/base.css';
import '../styles/theme-transitions.css';
import '../styles/theme.css';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import SearchPalette from '../components/site/SearchPalette.astro';
import { SITE } from '../data/site';

interface Props {
  /** Page <title>; defaults to the site title. */
  title?: string;
  /** meta description; defaults to the site description. */
  description?: string;
  /** Canonical path relative to the site root (e.g. '/download'); omit for the home page. */
  path?: string;
}

const {
  title = 'minnow.sh',
  description = 'Minnow — a full agentic development workspace. Open source, and completely yours.',
  path = '',
} = Astro.props;

const canonicalPath = path === '' || path === '/' ? '' : path.replace(/^\/+/, '').replace(/\/+$/, '');
const canonical = canonicalPath === '' ? `${SITE.url}/` : `${SITE.url}/${canonicalPath}`;

// OG meta (spec §5.4): per-page card from /og/<path>.jpg, human-dark colours.
const ogPath = canonicalPath === '' ? 'index' : canonicalPath;
const ogImage = `${SITE.url}/og/${ogPath}.jpg`;
const ogTitle = title.toLowerCase().endsWith('minnow.sh') || title === 'minnow.sh' ? title : `${title} — minnow.sh`;

// JSON-LD SoftwareApplication (site level, on every page).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Minnow',
  url: SITE.url,
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  author: { '@type': 'Person', name: SITE.author },
};
---
<!doctype html>
<html lang="en" data-theme="human-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0f0f" />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph + Twitter card (spec §5.4). The card is the per-page
         image from /og/ — glyph + title rendered in the site's own type. -->
    <meta property="og:site_name" content="minnow.sh" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- llms.txt (spec §5.5): machine-readable product + docs summary. -->
    <link rel="llms" href={`${SITE.url}/llms.txt`} type="text/plain" />
    <link rel="llms-full" href={`${SITE.url}/llms-full.txt`} type="text/plain" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Brand favicon set (spec §5.3). All five live in /brand/ and are
         theme-independent — the SVG favicon carries a prefers-color-scheme
         swap; the raster tiles bake the brand black. -->
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <!-- Flash guard — render-blocking, spec §7.4. The background map keeps the
         first paint the right colour before the CSS arrives; the apply order
         (no-transition → data-theme + colorScheme → two rAFs → theme-ready)
         matches the app. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var THEME_BG = {
          'swamp-dark':'#0f1216','swamp-light':'#f7f7f4','desert-dark':'#16140f','desert-light':'#f7f4ec',
          'ocean-dark':'#0d1117','ocean-light':'#f4f6f9','coral-dark':'#141416','coral-light':'#fafaf8',
          'mono-dark':'#2b2b2b','mono-light':'#f7f7f7','matrix-dark':'#040604','matrix-light':'#eef2ee',
          'human-dark':'#0f0f0f','human-light':'#fbf1ea','mint-dark':'#141615','mint-light':'#f2faf6'
        };
        var id, family, followSystem;
        try {
          id = localStorage.getItem('minnow.theme');
          family = localStorage.getItem('minnow.theme.family');
          followSystem = localStorage.getItem('minnow.theme.followSystem') === '1';
        } catch (e) { id = null; family = null; followSystem = false; }
        if (!THEME_BG[id]) {
          var mode = followSystem &&
            window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          var fam = family && THEME_BG[family + '-' + mode] ? family : 'human';
          id = fam + '-' + mode;
        }
        var modeSplit = id.indexOf('-');
        root.classList.add('theme-no-transition');
        root.setAttribute('data-theme', id);
        root.style.colorScheme = id.slice(modeSplit + 1);
        root.style.backgroundColor = THEME_BG[id];
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', THEME_BG[id]);
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            root.classList.remove('theme-no-transition');
            root.classList.add('theme-ready');
            root.style.backgroundColor = '';
            var bg = getComputedStyle(root).getPropertyValue('--mn-bg').trim();
            if (bg && meta) meta.setAttribute('content', bg);
          });
        });
      })();
    </script>
  </head>
  <body>
    <a class="mn-skip-link" href="#main">Skip to content</a>
    <Nav />
    <SearchPalette />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initTheme } from '../scripts/theme';
      import { initCopyButtons } from '../scripts/copy-button';
      import { initReveal, parkWhenHidden } from '../scripts/motion';
      import { initSeams } from '../scripts/seams';
      import { initBuildLoop } from '../scripts/build-loop';
      import { initSearch } from '../scripts/search';
      initTheme();
      initCopyButtons();
      initReveal();
      initSeams();
      parkWhenHidden();
      initBuildLoop();
      initSearch();
    </script>
  </body>
</html>
